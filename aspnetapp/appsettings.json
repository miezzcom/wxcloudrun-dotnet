{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Proxy": {
    "Host": "www.miezz.com"
  },
  "ReverseProxy": {
    "Routes": {
      "all": {
        "ClusterId": "production",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "production": {
        "Destinations": {
          "primary": {
            "Address": "https://116.62.125.28/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:10:00",
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        }
      }
    }
  }
}
